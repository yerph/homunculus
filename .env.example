# ========================================
# CC Companion Kit 配置文件
# 复制这个文件为 .env，然后填入你自己的值
# ========================================

# --- 聊天服务器 (chat-server) ---
# 聊天服务器端口，可以改成你喜欢的
CHAT_PORT=4500
# 网页聊天的登录密码
CHAT_PASSWORD=your-secret-password
# Original CC Hub from the running project (separate local process).
# Never reuse the browser password as a bridge token.
BRIDGE_AUTH_TOKEN=replace-with-another-long-random-secret
BRIDGE_CLIENT_PORT=3462
BRIDGE_INTERNAL_PORT=3463
BRIDGE_TMUX=your-existing-cc-tmux-session
BRIDGE_TMUX_USER=your-local-cc-user
BRIDGE_CC_SESSION_DIR=/absolute/path/to/your-claude-project-jsonl-directory
# Optional: set BRIDGE_DATA_DIR to a private writable absolute directory.
API_REQUEST_TIMEOUT_MS=120000

# --- 手机小组件 (phone-widget) ---
# 小组件前端端口
CLIENT_PORT=4600
# MCP Bridge 内部端口（给 Claude Code 连接用的）
BRIDGE_PORT=4601

# --- 域名（nginx 配置用） ---
DOMAIN=your-domain.com

# --- Bark 推送通知（可选，iOS 用户推荐） ---
# 从 Bark App 里获取你的 key
BARK_KEY_1=your-bark-key
# 如果有第二台设备
BARK_KEY_2=your-second-device-bark-key
# 通知图标
BARK_ICON_URL=https://example.com/your-icon.png
# 通知分组名
BARK_GROUP=companion

# --- Companion 身份信息 ---
# 你的 companion 的名字
COMPANION_NAME=Companion
# 头像显示的字母
COMPANION_AVATAR=C
